# Copy this file to .env and fill in your own values. .env is gitignored.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest if unset. If you hit a 429
# RESOURCE_EXHAUSTED / zero-quota error on a pinned version like
# gemini-2.0-flash, try gemini-flash-latest — quota varies per model.
# GEMINI_MODEL=gemini-flash-latest

# Optional — only set this if you're using the USB-serial ESP32+MPU6050 bridge
# SERIAL_PORT=COM3
